model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Date","Stream","Stream Participation","Stream Events","Raid Impact","Community Summary","Historical Comparison","Quality Source"]

annotation PBI_ProTooling = ["DevMode"]

ref table Date
ref table Stream
ref table 'Stream Participation'
ref table 'Stream Events'
ref table 'Raid Impact'
ref table 'Community Summary'
ref table 'Historical Comparison'
ref table 'Quality Source'

ref cultureInfo en-US
