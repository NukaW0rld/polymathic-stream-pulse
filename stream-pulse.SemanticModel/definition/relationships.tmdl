relationship DateToStream
	fromColumn: Stream.stream_local_date
	toColumn: Date.date

relationship StreamToParticipation
	fromColumn: 'Stream Participation'.stream_id
	toColumn: Stream.stream_id

relationship StreamToEvents
	fromColumn: 'Stream Events'.stream_id
	toColumn: Stream.stream_id

relationship StreamToRaidImpact
	fromColumn: 'Raid Impact'.stream_id
	toColumn: Stream.stream_id

relationship StreamToCommunity
	fromColumn: 'Community Summary'.stream_id
	toColumn: Stream.stream_id

relationship StreamToHistoricalComparison
	fromColumn: 'Historical Comparison'.stream_id
	toColumn: Stream.stream_id

relationship StreamToQualitySource
	fromColumn: 'Quality Source'.stream_id
	toColumn: Stream.stream_id
