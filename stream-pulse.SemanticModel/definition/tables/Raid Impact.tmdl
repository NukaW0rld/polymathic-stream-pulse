table 'Raid Impact'
	lineageTag: 409787f5-ef1c-4062-bc6f-cd59f8fa5266

	measure 'Average Viewer Change' = AVERAGE('Raid Impact'[viewer_change_from_baseline])
		formatString: +0.0;-0.0;0.0
		lineageTag: d5f5dca8-b44b-40b8-b61d-92caa13445c9

	measure 'Supported Raid Horizons' = COUNTROWS(FILTER('Raid Impact', 'Raid Impact'[viewer_horizon_available] && 'Raid Impact'[viewer_baseline_available] && NOT('Raid Impact'[overlapping_raid])))
		formatString: 0
		lineageTag: e5c7b507-114e-4667-b71a-1a376674ba36

