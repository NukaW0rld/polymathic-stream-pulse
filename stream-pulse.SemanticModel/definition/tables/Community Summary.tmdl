table 'Community Summary'
	lineageTag: 23034ac6-35c1-4fd6-849a-5777c1beadc2

	measure 'Active Chatters' = SUM('Community Summary'[active_chatter_count])
		formatString: 0
		lineageTag: 963141e6-b805-4e78-af7b-3e0fd488bd3e

	measure 'First Observed Chatters' = SUM('Community Summary'[first_observed_chatter_count])
