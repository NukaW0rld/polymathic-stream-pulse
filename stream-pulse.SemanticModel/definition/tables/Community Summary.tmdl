	partition 'Community Summary' = m
		mode: import
		source =
				let
				  Source = PostgreSQL.Database("localhost:5432", "stream_pulse"),
				  Data = Source{[Schema = "public", Item = "analytics_community_summary"]}[Data]
				in
				  Data

	annotation PBI_ResultType = Table
