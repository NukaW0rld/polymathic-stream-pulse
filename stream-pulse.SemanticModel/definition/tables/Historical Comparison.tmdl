table 'Historical Comparison'
	lineageTag: ca1803dc-a8db-4316-8f8d-0a03a8340a51

	measure 'Selected Viewer Difference vs Prior' = AVERAGE('Historical Comparison'[time_weighted_avg_viewers]) - AVERAGE('Historical Comparison'[all_stream_avg_viewers])
		formatString: +0.0;-0.0;0.0
		lineageTag: a469a113-0e03-495b-a315-ad50fde1a2ad

	measure 'Selected Viewer Difference vs Weekday' = AVERAGE('Historical Comparison'[time_weighted_avg_viewers]) - AVERAGE('Historical Comparison'[weekday_avg_viewers])
		formatString: +0.0;-0.0;0.0
		lineageTag: 04a11eca-5a42-47cb-8e02-2f3c48d5993e

	measure 'Prior Stream Sample Size' = MAX('Historical Comparison'[all_stream_sample_size])
		formatString: 0
		lineageTag: b80cf541-c8c3-44e0-94f9-b08b89f8f5e8

	measure 'Weekday Sample Size' = MAX('Historical Comparison'[weekday_sample_size])
