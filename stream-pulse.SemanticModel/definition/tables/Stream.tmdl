	partition Stream = m
		mode: import
		source =
				let
				  Source = PostgreSQL.Database("localhost:5432", "stream_pulse"),
				  Data = Source{[Schema = "public", Item = "analytics_stream_dimension"]}[Data]
				in
				  Data

	annotation PBI_ResultType = Table
